# Application Database URL (Default: SQLite local, or PostgreSQL in Docker)
DATABASE_URL=postgresql://crm_user:crm_password@db:5432/crm_db

# Initial Admin Credentials (Seeded on first startup)
ADMIN_NAME=Alex Rivera (System Admin)
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=adminpassword

# Real Email (SMTP / Gmail App Password) Configuration
ENABLE_REAL_EMAIL=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_TLS=True
EMAIL_FROM=your_email@gmail.com
